# 복사해서 .env 로 쓴다:  cp .env.example .env
# 비밀값은 없다. 포트·주소·이미지 번호만 둔다

# 바깥 포트. 사내 서버의 80(GitLab), 8088(와이어프레임), 8089·8443(AI Office), 8190(SCM)과 겹치지 않게 고른 값
HTTP_PORT=8091
HTTPS_PORT=9443

# 접속 주소 목록(쉼표 구분, IP 또는 도메인). 모두 자체 서명 인증서와 web_serve.py 의 허용 주소에 들어간다.
# DNS 등록 전에는 IP 로 바로 쓰고, 도메인은 쓰는 PC 의 hosts 파일에 '<서버 IP> dobbys.okestro.com' 을 넣어야 열린다.
# https://localhost:<HTTPS_PORT> 는 늘 함께 열린다
CERT_HOST=10.255.17.161,dobbys.okestro.com

# 이미지 번호와 사이드바 버전 줄. 보통:
#   IMAGE_TAG=$(git rev-parse --short HEAD) DOBBYS_COMMIT=$(git log -1 --format=%h) DOBBYS_COMMIT_DATE=$(git log -1 --format=%cs) docker compose up -d --build
IMAGE_TAG=local
DOBBYS_COMMIT=
DOBBYS_COMMIT_DATE=

# /api/jira 가 받는 Jira 주소 끝
JIRA_HOST_SUFFIX=.atlassian.net

# /api/trombone 이 부르는 기획서(TROMBONE) 주소. 컨테이너에서 닿는 http(s)://호스트[:포트][/하위 경로](. · .. · // 는 거절). 비우면 코멘트 탭이 '주소 미설정' 을 보인다
TROMBONE_BASE=
